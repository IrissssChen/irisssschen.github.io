[Unit]
Description=Kotonoha Kanji Puzzle
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/kotonoha-kanji-puzzle
ExecStart=/usr/bin/node self-host/server.mjs
Restart=on-failure
RestartSec=5s

# Resource limits — keep well under the ~930 MiB headroom
MemoryMax=128M
CPUQuota=30%

# Environment
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
Environment=DATABASE_PATH=/opt/kotonoha-kanji-puzzle/data/kotonoha.sqlite

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/kotonoha-kanji-puzzle/data
ReadOnlyPaths=/opt/kotonoha-kanji-puzzle

[Install]
WantedBy=multi-user.target
